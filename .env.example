# Salin ke .env lalu isi. JANGAN commit .env.
#   cp .env.example .env && source .env

# ── Wajib: Telegram ──
export TELEGRAM_BOT_TOKEN=""      # dari @BotFather
export TELEGRAM_CHAT_ID=""        # dari @userinfobot

# ── Opsional: sumber harga utama ──
# Tanpa ini sistem otomatis pakai Dukascopy (tidak butuh registrasi).
export TWELVEDATA_API_KEY=""      # twelvedata.com/register

# ── Opsional: sentimen news lewat LLM ──
# Endpoint apa pun yang OpenAI-compatible (OpenRouter, 9router, dll).
export LLM_BASE_URL=""
export LLM_API_KEY=""
export LLM_MODEL="anthropic/claude-sonnet-4.5"

# ── Opsional: saran ukuran posisi ──
export ACCOUNT_BALANCE="10000"
export RISK_PCT="0.5"

# ── Tampilan ──
export SIMPLE_MODE="1"            # 1 = pesan ringkas, kosong = lengkap

# ── Lokasi data runtime ──
export XAU_HOME="$HOME/.xau_signal"
