# Salin ke .env lalu isi. JANGAN commit .env.
#   cp .env.example .env && source .env

# ── Wajib: Telegram ──
export TELEGRAM_BOT_TOKEN=""      # dari @BotFather
export TELEGRAM_CHAT_ID=""        # dari @userinfobot — tujuan sinyal otomatis

# ── Opsional: izinkan command (/analisa dst) dari grup juga ──
# TELEGRAM_CHAT_ID di atas cuma dipakai untuk KIRIM sinyal otomatis.
# Untuk menjawab command di GRUP, chat_id grup (angka negatif, mis. -100...)
# harus didaftarkan di sini, dipisah koma kalau lebih dari satu chat/grup.
# Tanpa ini bot diam di grup — dianggap "chat asing" dan diabaikan.
export TELEGRAM_ALLOWED_CHATS=""  # mis. "123456789,-1001234567890"

# ── Opsional: sumber harga utama ──
# Tanpa ini sistem otomatis pakai Dukascopy (tidak butuh registrasi).
export TWELVEDATA_API_KEY=""      # twelvedata.com/register

# ── Opsional: sentimen news lewat LLM ──
# Endpoint apa pun yang OpenAI-compatible (OpenRouter, 9router, dll).
export LLM_BASE_URL=""
export LLM_API_KEY=""
export LLM_MODEL="anthropic/claude-sonnet-4.5"

# ── Opsional: saran ukuran posisi ──
export ACCOUNT_BALANCE="10000"
export RISK_PCT="0.5"

# ── Tampilan ──
export SIMPLE_MODE="1"            # 1 = pesan ringkas, kosong = lengkap

# ── Lokasi data runtime ──
export XAU_HOME="$HOME/.xau_signal"
